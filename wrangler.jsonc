{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wing-express",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
